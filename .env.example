APP_NAME=Demo AI API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash
GEMINI_DATASET_MODEL=
GEMINI_OUTPUT_MODEL=
GEMINI_GRADING_MODEL=
GEMINI_TEMPERATURE=0.2
GEMINI_DATASET_TEMPERATURE=0.4
GEMINI_OUTPUT_TEMPERATURE=0.2
GEMINI_GRADING_TEMPERATURE=0.0
ENV_FILE=.env
TZ=Asia/Ho_Chi_Minh
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=demo_admin
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-password
MONGO_INITDB_DATABASE=demo_ai
MONGO_URI=mongodb://demo_admin:replace-with-a-strong-password@mongodb:27017/demo_ai?authSource=admin
MONGO_ENABLED=false
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=replace-with-another-strong-password
ME_CONFIG_MONGODB_SERVER=mongodb
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_ADMINUSERNAME=demo_admin
ME_CONFIG_MONGODB_ADMINPASSWORD=replace-with-a-strong-password
ME_CONFIG_MONGODB_AUTH_DATABASE=admin
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=replace-with-another-strong-password
ME_PORT=8081
QDRANT_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT__SERVICE__API_KEY=


